# Edge AI Smart EV Charging Station Optimizer Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000

# Station Capacity & Hardware Limits
STATION_CAPACITY_KW=150.0
MAX_CHARGERS=10
DEFAULT_CHARGER_MAX_KW=22.0

# Database Settings (MongoDB with automatic local fallback)
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=smart_ev_charging_db

# Security & Secrets
SECRET_KEY=change-this-secret-key-in-production-use-a-secure-random-token
ALGORITHM=HS256

# Edge AI & Modes
EDGE_MODE=true
DEMO_MODE=true
